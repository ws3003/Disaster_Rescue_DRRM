# Disaster_Rescue_DRRM 环境变量示例
# 复制为 .env 并填入真实值; .env 已 gitignore, 永不提交!
# ============================================================
# 注意: 程序只读取进程环境变量, 不自动加载 .env 文件。
# ============================================================

# 通信渠道: mock | wecom | dingtalk  (默认 mock, 本地无网络演示/离线回归)
COMMUNICATION_CHANNEL=mock

# 钉钉机器人 Webhook (DingTalkChannel 使用; 留空则 mock)
# 格式: https://oapi.dingtalk.com/robot/send?access_token=你的token
DINGTALK_WEBHOOK=

# 企业微信群机器人 Webhook (WeComChannel 使用; 留空则 mock)
# 格式: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key
WECOM_WEBHOOK_URL=

# ---------------------------------------------------------------
# V4.0-A VLM / LLM (Qwen 云端 API; 不填则走内建 mock provider)
# ---------------------------------------------------------------
# VLM Provider 选择: mock / qwen
# (VLMClient(provider=...) 显式传参时优先于本变量)
VLM_PROVIDER=mock

# Qwen VLM — OpenAI 兼容接口 (DashScope compatible-mode)
# 调用 qwen provider 时必需
VLM_API_KEY=

# OpenAI 兼容端点 (留空使用默认 DashScope 地址)
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名 (留空使用默认 qwen3-vl-plus)
VLM_MODEL=qwen3-vl-plus

# 请求超时秒数 (留空使用默认 30)
VLM_TIMEOUT=30

# ---------------------------------------------------------------

# LLM Provider 选择: mock / qwen
# (LLMClient(provider=...) 显式传参时优先于本变量)
LLM_PROVIDER=mock

# Qwen LLM — OpenAI 兼容接口 (DashScope compatible-mode)
# 调用 qwen provider 时必需
LLM_API_KEY=

# OpenAI 兼容端点 (留空使用默认 DashScope 地址)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名 (留空使用默认 qwen-plus)
LLM_MODEL=qwen-plus

# 请求超时秒数 (留空使用默认 30)
LLM_TIMEOUT=30

# ---------------------------------------------------------------
# Snapshot 存储 (Phase 2.6)
# ---------------------------------------------------------------
# 本地 snapshot URL 前缀 (实际静态服务由 server.api 挂载 data/snapshots/)
# 如需外部可访问(如 DingTalk picURL), 改为可达的公网/隧道地址
STORAGE_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------
# V4.1 Assistant 天气 (Phase5.1)
# ---------------------------------------------------------------
# WEATHER_PROVIDER: mock(默认, 零网络) / live(真实天气 API)
WEATHER_PROVIDER=mock
WEATHER_API_KEY=
# 天气 API 端点 (live 必需; 例如和风: https://devapi.qweather.com/v7/weather/now)
WEATHER_BASE_URL=

# ---------------------------------------------------------------
# V4.1 Assistant 地图 (Phase5.2)
# ---------------------------------------------------------------
# MAP_PROVIDER: mock(默认, 零网络) / live(真实地图 API)
MAP_PROVIDER=mock
MAP_API_KEY=
# 高德 AMap Web 服务端点 (live 必需)
MAP_GEOCODE_URL=https://restapi.amap.com/v3/geocode/geo
MAP_ROUTE_URL=https://restapi.amap.com/v3/direction/driving

# 预留: 阿里云 OSS (未接入); AK/SK 仅走环境变量
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=