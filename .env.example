# Disaster_Rescue_DRRM 环境变量示例
# 复制为 .env 并填入真实值; .env 已 gitignore, 永不提交!

# 通信渠道: mock | wecom | dingtalk  (默认 mock, 本地无网络演示/离线回归)
COMMUNICATION_CHANNEL=mock

# 钉钉机器人 Webhook (DingTalkChannel 使用; 留空则 mock)
# 格式: https://oapi.dingtalk.com/robot/send?access_token=你的token
DINGTALK_WEBHOOK=

# 企业微信群机器人 Webhook (WeComChannel 使用; 留空则 mock)
# 格式: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key
WECOM_WEBHOOK_URL=

# V4.0-A VLM / LLM (Qwen 云端 API; 不填则走内建 mock provider)
VLM_API_KEY=
VLM_PROVIDER=mock
LLM_API_KEY=
LLM_PROVIDER=mock