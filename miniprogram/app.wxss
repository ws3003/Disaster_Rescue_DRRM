page {
  background: #f3f4f6;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  margin: 8rpx 0 20rpx;
}

.section {
  margin-bottom: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(17, 24, 39, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.mono {
  font-family: "SFMono-Regular", Consolas, monospace;
  word-break: break-all;
}

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 0;
}

.row-label {
  color: #6b7280;
  flex: 0 0 auto;
}

.row-value {
  flex: 1 1 auto;
  text-align: right;
  word-break: break-all;
}

.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.7;
  background: #e5e7eb;
  color: #374151;
}

.tag-person {
  background: #fee2e2;
  color: #991b1b;
}

.tag-sensor {
  background: #dbeafe;
  color: #1e40af;
}

.tag-active {
  background: #fef3c7;
  color: #92400e;
}

.tag-resolved {
  background: #dcfce7;
  color: #166534;
}

.notice {
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}

.notice-mock {
  background: #ede9fe;
  color: #5b21b6;
  border: 1rpx solid #c4b5fd;
}

.notice-warn {
  background: #fff7ed;
  color: #9a3412;
  border: 1rpx solid #fdba74;
}

.notice-error {
  background: #fef2f2;
  color: #991b1b;
  border: 1rpx solid #fecaca;
}

.state-block {
  padding: 36rpx 20rpx;
  text-align: center;
  color: #6b7280;
}

.state-title {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 8rpx;
}

.btn {
  display: inline-block;
  margin-top: 16rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #1f2937;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1.6;
}

.btn-ghost {
  background: transparent;
  color: #1f2937;
  border: 1rpx solid #9ca3af;
}

.link {
  color: #1d4ed8;
  font-size: 24rpx;
}

.divider {
  height: 1rpx;
  background: #e5e7eb;
  margin: 16rpx 0;
}

.list-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.list-item:last-child {
  border-bottom: none;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.item-title {
  font-size: 29rpx;
  font-weight: 600;
  flex: 1 1 auto;
  word-break: break-all;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 8rpx;
}

.chip {
  background: #f3f4f6;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: #374151;
}

.chip-key {
  color: #6b7280;
  margin-right: 6rpx;
}

.footer-state {
  text-align: center;
  color: #6b7280;
  font-size: 24rpx;
  padding: 24rpx 0;
}

.tabs {
  display: flex;
  background: #e5e7eb;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1 1 0;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 8rpx;
  color: #374151;
  font-size: 26rpx;
}

.tab-active {
  background: #ffffff;
  color: #111827;
  font-weight: 600;
  box-shadow: 0 1rpx 4rpx rgba(17, 24, 39, 0.12);
}

.stat-grid {
  display: flex;
  gap: 16rpx;
}

.stat {
  flex: 1 1 0;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 18rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stat-label {
  color: #6b7280;
  font-size: 22rpx;
}
