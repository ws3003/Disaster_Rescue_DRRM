<template name="alertItem">
  <view
    class="list-item"
    hover-class="list-item-hover"
    bindtap="onItemTap"
    data-key="{{item.alertKey}}"
  >
    <view class="item-head">
      <view class="item-title">{{item.title}}</view>
      <text
        wx:if="{{item.severityText !== '—'}}"
        class="sev-badge {{item.severityClass}}"
      >{{item.severityText}}</text>
    </view>

    <view class="item-meta">
      <text class="tag {{item.categoryClass}}">{{item.categoryLabel}}</text>
      <text>{{item.timeText}}</text>
      <text wx:if="{{item.relativeText}}" class="item-relative">{{item.relativeText}}</text>
    </view>

    <view class="item-more">查看详情 ›</view>
  </view>
</template>
