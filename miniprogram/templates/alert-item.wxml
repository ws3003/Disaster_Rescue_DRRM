<template name="alertItem">
  <view class="list-item" bindtap="onItemTap" data-key="{{item.alertKey}}">
    <view class="item-head">
      <view class="item-title">{{item.title}}</view>
      <text class="tag {{item.categoryClass}}">{{item.categoryLabel}}</text>
    </view>
    <view class="muted">{{item.timeLabel}}：{{item.timeText}}</view>
    <view class="muted">严重程度：{{item.severityText}}<text wx:if="{{item.statusText}}">　状态：{{item.statusText}}</text></view>
    <view class="chips" wx:if="{{item.chips.length}}">
      <view class="chip" wx:for="{{item.chips}}" wx:for-item="chip" wx:key="label">
        <text class="chip-key">{{chip.label}}</text>{{chip.value}}
      </view>
    </view>
  </view>
</template>
